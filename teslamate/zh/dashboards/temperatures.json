          "rawSql": "WITH binned AS (\n  SELECT\n    to_timestamp(floor(extract(epoch FROM date) / 900) * 900) AS bin,\n    avg(outside_temp) AS outside_temp\n  FROM positions\n  WHERE car_id = $car_id AND outside_temp IS NOT NULL AND $__timeFilter(date)\n  GROUP BY 1\n)\nSELECT\n  date_trunc('day', bin, '$__timezone') AS time,\n  convert_celsius(max(outside_temp), '$temp_unit') AS \"Max Temp\",\n  convert_celsius(min(outside_temp), '$temp_unit') AS \"Min Temp\",\n  convert_celsius(percentile_cont(0.15) WITHIN GROUP (ORDER BY outside_temp::double precision)::numeric, '$temp_unit') AS \"15th Percentile\",\n  convert_celsius(percentile_cont(0.85) WITHIN GROUP (ORDER BY outside_temp::double precision)::numeric, '$temp_unit') AS \"85th Percentile\",\n  count(*) * 100 / 96 AS \"Coverage\"\nFROM binned\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "每日车外温度（最低/最高，p15–p85）",
      "type": "candlestick"
    }
  ],
